(version 1)

(rule "PSE drill compensation annular ring"
    (constraint annular_width (min 0.25mm))
)
(rule "Relay load minimum trace width"
    (condition "A.hasNetclass('Relay_Load')")
    (constraint track_width (min 1.60mm) (opt 1.60mm))
)

(rule "Relay load copper clearance"
    (condition "A.hasNetclass('Relay_Load') || B.hasNetclass('Relay_Load')")
    (constraint clearance (min 0.50mm))
)

(rule "Compact relay terminal labels use a condensed font"
    (condition "A.memberOfGroup('Compact relay terminal labels') && A.Height >= 1.3mm")
    (constraint text_height (min 0.76mm))
)
