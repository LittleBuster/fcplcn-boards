(version 1)
(rule "35um production copper clearance" (constraint clearance (min 0.175mm)))
(rule "35um production track width" (constraint track_width (min 0.18mm)))
(rule "35um production annular ring" (constraint annular_width (min 0.2mm)))
(rule "35um zone clearance" (condition "A.Type == 'Zone' || B.Type == 'Zone'") (constraint clearance (min 0.2mm)))
(rule "DIP USB-C J2 manufacturer limit annulus" (condition "A.Type == 'Pad' && A.memberOfFootprint('J2')") (constraint annular_width (min 0.15mm)))
(rule "Galvanic domain clearance"
 (condition "(A.NetName == '/*_ISO' || A.NetName == '/RS485_A' || A.NetName == '/RS485_B' || A.NetName == '/RS485_TERM' || A.NetName == '/RS485_VISO' || A.NetName == '/RS485_VISO_OUT') != (B.NetName == '/*_ISO' || B.NetName == '/RS485_A' || B.NetName == '/RS485_B' || B.NetName == '/RS485_TERM' || B.NetName == '/RS485_VISO' || B.NetName == '/RS485_VISO_OUT')")
 (constraint clearance (min 1.5mm)))

(rule "Four Ethernet signals35um standard width"
 (condition "A.NetName == '/ETH_CS_N' || A.NetName == '/ETH_SCK' || A.NetName == '/ETH_MOSI' || A.NetName == '/ETH_MISO'")
 (constraint track_width (min 0.175mm)))

# BEGIN REVIEWED LOCAL FACTORY VIAS
# Ordinary vias remain0.7/0.3 with0.20mm nominal annulus. Only listed net+coordinate sites use the explicit factory limit.
(rule "Ordinary production via diameter" (condition "A.Type == 'Via'") (constraint via_diameter (min 0.7mm)) (constraint annular_width (min 0.2mm)))
# Reviewed UUID e4cdfbb9-a543-4129-986a-9dc3807368de; /+3V3 at 79.05,85.55 mm; keep0.175mm copper clearance.
(rule "Reviewed factory via e4cdfbb9" (condition "A.Type == 'Via' && A.NetName == '/+3V3' && A.Position_X == 79.05mm && A.Position_Y == 85.55mm") (constraint via_diameter (min 0.6mm)) (constraint annular_width (min 0.15mm)))
